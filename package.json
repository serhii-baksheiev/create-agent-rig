{
  "name": "create-agent-rig",
  "version": "0.10.1",
  "description": "Configure an agent operating system (rules, gates, hooks) for Claude Code and Codex in a new or existing repository — no application scaffolding",
  "keywords": [
    "agent",
    "claude-code",
    "codex",
    "agent-os",
    "rules",
    "hooks",
    "governance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serhii-baksheiev/create-agent-rig.git"
  },
  "homepage": "https://github.com/serhii-baksheiev/create-agent-rig#readme",
  "bugs": "https://github.com/serhii-baksheiev/create-agent-rig/issues",
  "type": "module",
  "bin": {
    "create-agent-rig": "packages/cli/dist/index.js"
  },
  "files": [
    "packages/cli/dist",
    "templates",
    "scripts/prepare.mjs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "build": "node scripts/prepare.mjs --build-only",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p packages/cli/tsconfig.json && tsc -p tsconfig.json",
    "test": "pnpm build && vitest run",
    "test:unit": "vitest run --project unit --project template",
    "test:smoke": "vitest run --project unit",
    "test:e2e": "pnpm build && vitest run --project e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.0"
  }
}
