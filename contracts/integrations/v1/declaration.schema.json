{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/serhii-baksheiev/create-agent-rig/contracts/integrations/v1/declaration.schema.json",
  "title": "Rig integrations declaration",
  "description": "The accepted shape of .rig/integrations.json (RP-22 S1). Validated with the dependency-free subset in scripts/lib/json-schema-subset.mjs — no $ref, no oneOf.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "integrations"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "selected"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "selected": {
            "type": "boolean",
            "const": true,
            "description": "Explicit provider selection; required by hosted MCP descriptors before activation."
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "harnesses": {
            "description": "Non-empty and duplicate-free — enforced by declaration.ts's parser, not by this schema: scripts/lib/json-schema-subset.mjs's supported keyword set has no minItems or uniqueItems (RP-22 gate cycle 1, advisory (e)). Extending that shared validator is out of scope for this PR.",
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["claude-code", "codex"]
            }
          },
          "targets": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claude-code": {
                "type": "object",
                "additionalProperties": false,
                "required": ["entryHash"],
                "properties": { "entryHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
              },
              "codex": {
                "type": "object",
                "additionalProperties": false,
                "required": ["entryHash"],
                "properties": { "entryHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
              }
            }
          }
        }
      }
    }
  }
}
