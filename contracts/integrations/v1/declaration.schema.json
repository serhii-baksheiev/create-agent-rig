{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/serhii-baksheiev/create-agent-rig/contracts/integrations/v1/declaration.schema.json",
  "title": "Rig integrations declaration",
  "description": "The public shape of .rig/integrations.json. The CLI validates intent with packages/cli/src/integrations/declaration.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "integrations"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "selected"],
        "allOf": [
          {
            "if": {
              "required": ["id"],
              "properties": { "id": { "enum": ["probity", "spec-kit"] } }
            },
            "then": {
              "properties": {
                "version": {
                  "type": "string",
                  "description": "One exact release, MAJOR.MINOR.PATCH[-prerelease]: no range, no tag, no leading v.",
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
                }
              }
            }
          },
          {
            "if": {
              "required": ["id"],
              "properties": { "id": { "const": "bmad-tea" } }
            },
            "then": {
              "properties": {
                "version": {
                  "type": "string",
                  "description": "One exact release, optionally with the leading v BMAD's installer records.",
                  "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
                }
              }
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "selected": {
            "type": "boolean",
            "const": true,
            "description": "Explicit provider selection, required before activation."
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "harnesses": {
            "description": "Non-empty and duplicate-free, enforced by the declaration parser.",
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["claude-code", "codex"]
            }
          },
          "targets": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claude-code": {
                "type": "object",
                "additionalProperties": false,
                "required": ["entryHash"],
                "properties": {
                  "entryHash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "configHash": {
            "description": "Probity only: the SHA-256 of the Rig-generated probity.config.mjs bytes.",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileHash"],
          "properties": {
            "fileHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
